#
# This file is deprecated and kept only for backward compatibility
# with projects that still do include(${SimpleITK_USE_FILE}).  Modern
# consumers should use SimpleITK's CMake targets directly, e.g.
# find_package(SimpleITK) and
# target_link_libraries(your_target ${SimpleITK_LIBRARIES}), or link
# the specific imported SimpleITK targets.
#

message(
  WARNING
  "SimpleITK_USE_FILE (UseSimpleITK.cmake) is deprecated, use \
  SimpleITK's CMake targets instead. See the migration guide: \
  https://simpleitk.readthedocs.io/en/main/migrationGuide3.0.html#simpleitk-use-file-deprecated"
)

# Add include directories needed to use SimpleITK.
include_directories(${SimpleITK_INCLUDE_DIRS})

# Add link directories needed to use SimpleITK.
link_directories(${SimpleITK_LIBRARY_DIRS})
